ANTHROPIC_API_KEY=your_anthropic_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gate de pagamento (onboarding -> Kiwify -> /pagamento) — ver middleware.js
# e app/api/webhooks/kiwify
NEXT_PUBLIC_PAYMENT_LINK_URL=https://pay.kiwify.com.br/xxxxx
# service_role key do Supabase (Project Settings > API) — só o webhook do
# Kiwify usa, pra escrever em paid_emails ignorando RLS. NUNCA prefixar com
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Mesmo valor colado no campo "Token" ao criar o webhook no painel do Kiwify —
# qualquer string secreta que você escolher.
KIWIFY_WEBHOOK_TOKEN=your_own_random_secret

# Agente de voz (ElevenLabs Conversational AI) - ver docs/elevenlabs-agent-setup.md
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# ── AbacatePay (checkout hospedado, cartão + PIX) ────────────────────────────
# API key (server-only, NUNCA prefixar com NEXT_PUBLIC_). Use a chave de DEV
# pra testar e a de PROD só em produção.
ABACATEPAY_API_KEY=abc_dev_xxx_ou_prod_xxx
# Mesmo valor do campo "secret" ao criar o webhook no painel do AbacatePay.
# Vai na query da URL do webhook (?webhookSecret=...) e valida o HMAC.
ABACATEPAY_WEBHOOK_SECRET=uma_string_secreta_aleatoria
# prod_... impresso por: node scripts/abacate-setup-products.mjs
ABACATEPAY_PROD_PRO_TRIMESTRAL=prod_xxx
# URL pública base (returnUrl/completionUrl). Sem barra no fim.
NEXT_PUBLIC_APP_URL=https://cadenceenglish.app
