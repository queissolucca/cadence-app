ANTHROPIC_API_KEY=your_anthropic_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gate de pagamento (onboarding -> Kiwify -> /pagamento) — ver middleware.js
# e app/api/webhooks/kiwify
NEXT_PUBLIC_PAYMENT_LINK_URL=https://pay.kiwify.com.br/xxxxx
# service_role key do Supabase (Project Settings > API) — só o webhook do
# Kiwify usa, pra escrever em paid_emails ignorando RLS. NUNCA prefixar com
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Mesmo valor colado no campo "Token" ao criar o webhook no painel do Kiwify —
# qualquer string secreta que você escolher.
KIWIFY_WEBHOOK_TOKEN=your_own_random_secret

# Agente de voz (ElevenLabs Conversational AI) - ver docs/elevenlabs-agent-setup.md
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id
